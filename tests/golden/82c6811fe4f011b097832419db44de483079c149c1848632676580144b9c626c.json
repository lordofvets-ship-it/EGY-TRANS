    {
      "timeStart": "00:12",
      "timeEnd": "00:16",
      "speaker": "العميل",
      "text": "أنا سلام بحضرتك، كنت عايزة أستفسر من خلال كود مستشار أحمد حسان، الشيخ زايد، عمارة مستثمر الصغير",
      "duration": 4
    },
    {
      "timeStart": "00:16",
      "timeEnd": "00:18",
      "speaker": "موظف خدمة العملاء",
      "text": "أهلاً بحضرتك، اتفضلي يا فندم، أقدر أساعد حضرتك إزاي؟",
      "duration": 2
    },
    {
      "timeStart": "00:18",
      "timeEnd": "00:23",
      "speaker": "العميل",
      "text": "أنا كنت عايزة، أنا كنت طلبت بولي فريش (Polyfresh)، جاتلي القطرة، أنا كنت عايزة اللي هي أحادية الجرعة",
      "duration": 5
    },
    {
      "timeStart": "00:24",
      "timeEnd": "00:27",
      "speaker": "موظف خدمة العملاء",
      "text": "تمام، لحظات معايا يا فندم، هراجع السيستم لحضرتك وأشوف التوفر",
      "duration": 3
    },
    {
      "timeStart": "00:27",
      "timeEnd": "00:28",
      "speaker": "العميل",
      "text": "تمام",
      "duration": 1
    },
    {
      "timeStart": "00:28",
      "timeEnd": "00:30",
      "speaker": "موظف خدمة العملاء",
      "text": "حضرتك هتطلبي الأوردر من خلال نفس الرقم ونفس العنوان؟",
      "duration": 2
    },
    {
      "timeStart": "00:30",
      "timeEnd": "00:31",
      "speaker": "العميل",
      "text": "آه، آه، نفس الرقم",
      "duration": 1
    },
    {
      "timeStart": "00:31",
      "timeEnd": "00:33",
      "speaker": "موظف خدمة العملاء",
      "text": "من خلال الواتساب أبلكيشن أو مكالمات؟",
      "duration": 2
    },
    {
      "timeStart": "00:33",
      "timeEnd": "00:34",
      "speaker": "العميل",
      "text": "لا لا، كلمني من المكالمة",
      "duration": 1
    },
    {
      "timeStart": "00:35",
      "timeEnd": "00:36",
      "speaker": "موظف خدمة العملاء",
      "text": "تمام، لحظات",
      "duration": 1
    },
    {
      "timeStart": "00:50",
      "timeEnd": "00:52",
      "speaker": "موظف خدمة العملاء",
      "text": "بعتذر لحضرتك، لحظات",
      "duration": 2
    },
    {
      "timeStart": "01:00",
      "timeEnd": "01:01",
      "speaker": "موظف خدمة العملاء",
      "text": "معايا يا فندم؟",
      "duration": 1
    },
    {
      "timeStart": "01:01",
      "timeEnd": "01:02",
      "speaker": "العميل",
      "text": "معاكي",
      "duration": 1
    },
    {
      "timeStart": "01:02",
      "timeEnd": "01:08",
      "speaker": "موظف خدمة العملاء",
      "text": "أنا بعتذر لحضرتك جداً، بخصوص بولي فريش (Polyfresh) أحادية الجرعة، هي متوفرة حالياً، هضيفها لحضرتك للأوردر، تحبي أضيف أي حاجة تانية؟",
