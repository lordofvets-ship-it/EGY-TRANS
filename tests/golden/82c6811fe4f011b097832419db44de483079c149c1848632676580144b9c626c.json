    },
    {
      "timeStart": "01:08",
      "timeEnd": "01:09",
      "speaker": "العميل",
      "text": "لا شكراً",
      "duration": 1
    },
    {
      "timeStart": "01:09",
      "timeEnd": "01:13",
      "speaker": "موظف خدمة العملاء",
      "text": "تمام، إجمالي الطلب 145 جنيه، تحت أمرك يا فندم في أي استفسار آخر؟",
      "duration": 4
    },
    {
      "timeStart": "01:13",
      "timeEnd": "01:14",
      "speaker": "العميل",
      "text": "لا شكراً، شكراً",
      "duration": 1
    },
    {
      "timeStart": "03:43",
      "timeEnd": "03:45",
      "speaker": "موظف خدمة العملاء",
      "text": "معايا؟",
      "duration": 2
    },
    {
      "timeStart": "03:45",
      "timeEnd": "03:47",
      "speaker": "العميل",
      "text": "أيوه.",
      "duration": 2
    },
    {
      "timeStart": "03:47",
      "timeEnd": "03:52",
      "speaker": "موظف خدمة العملاء",
      "text": "بعتذر على الإطالة وشكراً على الانتظار، وحضرتك كنتِ موضحة للزميلة إنك محتاجة الأمبول الأحادية؟",
      "duration": 5
    },
    {
      "timeStart": "03:53",
      "timeEnd": "03:58",
      "speaker": "العميل",
      "text": "فأنا فاكرة إني قلت قطرة، أنا قلت لها بولي فريش فما حددتش بقى تقريباً والله.",
      "duration": 5
    },
    {
      "timeStart": "03:59",
      "timeEnd": "04:06",
      "speaker": "موظف خدمة العملاء",
      "text": "تمام، هو السيستم المرتجع عندنا هتكون الأوردر يعني المنتج بيروح لحضرتك، المندوب بيروح لحضرتك.",
      "duration": 7
    },
    {
      "timeStart": "04:06",
      "timeEnd": "04:07",
      "speaker": "العميل",
      "text": "خلاص خلاص ما هو رجع رجع رجع خلاص.",
